# Generated secrets are filled by deploy/scripts/init-env.sh.
SPRING_PROFILES_ACTIVE=prod
APP_TIMEZONE=Asia/Shanghai
SERVER_PORT=8081

SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/IntelliDoc?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=intellidoc
SPRING_DATASOURCE_PASSWORD=__MYSQL_PASSWORD__
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=__REDIS_PASSWORD__

SPRING_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
SPRING_KAFKA_TOPIC_PARTITIONS=1
SPRING_KAFKA_TOPIC_REPLICATION_FACTOR=1
# Single-broker deployment. For a three-broker HA cluster, set these to 3 and 2.
SPRING_KAFKA_TOPIC_MIN_INSYNC_REPLICAS=1

MINIO_ENDPOINT=http://127.0.0.1:19000
MINIO_PUBLIC_URL=__MINIO_PUBLIC_URL__
MINIO_ACCESS_KEY=intellidoc
MINIO_SECRET_KEY=__MINIO_ROOT_PASSWORD__
MINIO_BUCKET_NAME=uploads

ELASTICSEARCH_HOST=127.0.0.1
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=__ELASTIC_PASSWORD__
ELASTICSEARCH_INSECURE_TRUST_ALL_CERTIFICATES=false
ELASTICSEARCH_INIT_ENABLE=true

JWT_SECRET_KEY=__JWT_SECRET_KEY__

# The prod profile keeps bootstrap disabled. For the one-time admin creation,
# run deploy/scripts/create-admin.sh after editing the username/password below.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=__ADMIN_PASSWORD__
ADMIN_BOOTSTRAP_PRIMARY_ORG=default
ADMIN_BOOTSTRAP_ORG_TAGS=default,admin

APP_AUTH_REGISTRATION_MODE=INVITE_ONLY
APP_AUTH_INVITE_REQUIRED=true
SECURITY_ALLOWED_ORIGINS=__APP_ORIGIN__

DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_API_MODEL=deepseek-chat
DEEPSEEK_API_KEY=CHANGE_ME
EMBEDDING_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_MODEL=text-embedding-v4
EMBEDDING_API_KEY=CHANGE_ME
EMBEDDING_DIMENSION=2048

KNOWLEDGE_BOOTSTRAP_ENABLED=false
FILE_PARSING_PDF_ENGINE=liteparse
FILE_PARSING_LITEPARSE_COMMAND=/opt/intellidoc/liteparse/bin/lit
FILE_PARSING_LITEPARSE_OCR_ENABLED=false
FILE_PARSING_LITEPARSE_OCR_LANGUAGE=chi_sim
FILE_PARSING_LITEPARSE_DPI=300

ALIYUN_OCR_ENABLED=false
WX_PAY_ENABLE=false
LOG_LEVEL_APP=INFO
