# Copy to .env.infrastructure with deploy/scripts/init-env.sh.
# Docker Compose uses this file only for infrastructure containers.
MYSQL_DATABASE=IntelliDoc
MYSQL_USER=intellidoc
MYSQL_PASSWORD=__MYSQL_PASSWORD__
MYSQL_ROOT_PASSWORD=__MYSQL_ROOT_PASSWORD__

REDIS_PASSWORD=__REDIS_PASSWORD__

MINIO_ROOT_USER=intellidoc
MINIO_ROOT_PASSWORD=__MINIO_ROOT_PASSWORD__
MINIO_BUCKET_NAME=uploads
MINIO_PUBLIC_PORT=19000

ELASTIC_PASSWORD=__ELASTIC_PASSWORD__
ES_JAVA_OPTS=-Xms1g -Xmx1g
