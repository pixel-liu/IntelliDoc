[Unit]
Description=IntelliDoc Spring Boot backend
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=intellidoc
Group=intellidoc
WorkingDirectory=/opt/intellidoc
EnvironmentFile=/etc/intellidoc/app.env
ExecStart=/usr/bin/java -Xms512m -Xmx1536m -Djava.security.egd=file:/dev/urandom -jar /opt/intellidoc/app.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=65535
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/intellidoc/logs

[Install]
WantedBy=multi-user.target
